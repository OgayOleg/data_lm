[flake8]
max-line-length = 110
extend-ignore = E203, W503
exclude =
    .git,
    .venv,
    __pycache__,
    build,
    dist,
    notebooks,
    .ipynb_checkpoints
per-file-ignores =
    # тестовые данные и параметризованные тесты: разрешаем длинные строки
    tests/*:E501
    # HTML-шаблоны презентации и ноутбуков содержат длинные строки разметки
    scripts/build_presentation.py:E501
    scripts/build_notebooks.py:E501
count = true
statistics = true
